# Required: a Meta access token with ads_read on the ad account (a System User token is best: it doesn't expire).
META_ACCESS_TOKEN=

# The Mark My Words Media ad account.
META_AD_ACCOUNT_ID=act_1228742844209195

# Optional: password-protect the report (any username, this password).
REPORT_PASSWORD=

# Optional settings (defaults shown).
REPORT_TIMEZONE=America/New_York
CACHE_MINUTES=15
META_API_VERSION=v21.0
# Which Meta events count as each KPI.
FORM_FILL_EVENT=offsite_conversion.fb_pixel_custom.form_start
LEAD_EVENT=offsite_conversion.fb_pixel_lead
APPOINTMENT_EVENT_MATCH=schedule
