---
import site from '../../lib/config.js';
import Button from '../Button.astro';
import Icon from '../Icon.astro';

const hero = site.hero;
---

<section id="top" class="bg-surface">
  <div class="shell grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">
    <div>
      {hero.eyebrow && <p class="eyebrow mb-3">{hero.eyebrow}</p>}
      <h1 class="text-4xl leading-[1.1] font-bold sm:text-5xl lg:text-6xl">{hero.headline}</h1>
      {hero.subhead && <p class="lede mt-5 max-w-xl">{hero.subhead}</p>}

      {
        hero.bullets?.length > 0 && (
          <ul class="mt-7 space-y-3">
            {hero.bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <Icon name="check" class="mt-0.5 h-5 w-5 shrink-0 text-brand" />
                <span class="font-medium">{bullet}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <Button {...hero.primaryCta} size="lg" track="cta-hero" />
        {hero.secondaryCta && <Button {...hero.secondaryCta} variant="ghost" size="lg" />}
      </div>
    </div>

    {
      hero.image && (
        <div class="relative">
          <img
            src={hero.image}
            alt={hero.imageAlt}
            width="1200"
            height="900"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/3] w-full rounded-[var(--radius-brand)] object-cover shadow-lg"
          />
        </div>
      )
    }
  </div>
</section>
