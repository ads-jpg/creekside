---
import site from '../../lib/config.js';

const faq = site.faq;
const items = faq.items ?? [];
---

<section class="section bg-subtle">
  <div class="shell max-w-3xl">
    {faq.headline && <h2 class="h2 text-center">{faq.headline}</h2>}

    <div class="mt-10 divide-y divide-black/10 border-y border-black/10">
      {
        items.map((item) => (
          <details class="group py-5" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-lg font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <svg
                class="h-5 w-5 shrink-0 text-brand transition-transform group-open:rotate-45"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p class="mt-3 leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
