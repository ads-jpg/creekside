---
import site from '../lib/config.js';
import Icon from './Icon.astro';

const header = site.header ?? {};
const sticky = header.sticky !== false;
---

<header
  class:list={[
    'z-40 w-full border-b border-black/5 bg-surface/95 backdrop-blur-sm',
    sticky && 'sticky top-0',
  ]}
>
  <div class="shell flex items-center justify-between gap-4 py-3">
    <a href="#top" class="flex items-center gap-3 text-ink no-underline" aria-label={site.client.name}>
      {
        site.brand.logo ? (
          <img
            src={site.brand.logo}
            alt={`${site.client.name} logo`}
            width={site.brand.logoWidth ?? 168}
            height={40}
            class="h-9 w-auto text-brand sm:h-10"
            style="color:var(--brand-primary)"
          />
        ) : (
          <span class="text-lg font-bold sm:text-xl">{site.client.name}</span>
        )
      }
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      {
        header.showPhone !== false && (
          <a
            href={`tel:${site.contact.phone}`}
            data-track="call"
            class="flex items-center gap-2 font-semibold text-ink no-underline hover:text-brand"
          >
            <Icon name="phone" class="h-5 w-5 text-brand" />
            <span class="hidden sm:inline">{site.contact.phoneDisplay}</span>
            <span class="sr-only sm:hidden">Call {site.contact.phoneDisplay}</span>
          </a>
        )
      }
      {
        header.ctaLabel && (
          <a
            href={header.ctaHref ?? '#lead-form'}
            data-track="cta-header"
            class="btn btn-primary hidden px-5 py-2.5 text-sm sm:inline-flex"
          >
            {header.ctaLabel}
          </a>
        )
      }
    </div>
  </div>
</header>
