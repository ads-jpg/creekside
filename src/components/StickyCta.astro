---
import site from '../lib/config.js';
import Icon from './Icon.astro';

const cta = site.stickyCta ?? {};
---

{/* Phone-only action bar. Hidden once the lead form is on screen so it never covers it. */}
<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-40 flex translate-y-full gap-2 border-t border-black/10 bg-white/95 p-3 shadow-[0_-4px_16px_rgba(0,0,0,0.08)] backdrop-blur transition-transform duration-200 sm:hidden"
  data-hidden="true"
>
  {
    cta.showCall !== false && (
      <a
        href={`tel:${site.contact.phone}`}
        data-track="call"
        class="btn btn-ghost flex-1 px-3 py-2.5 text-sm"
        aria-label={`Call ${site.contact.phoneDisplay}`}
      >
        <Icon name="phone" class="h-5 w-5" />
        Call
      </a>
    )
  }
  <a
    href={cta.href ?? '#lead-form'}
    data-track="cta-sticky"
    class="btn btn-primary flex-[2] px-3 py-2.5 text-sm"
  >
    {cta.label ?? 'Get My Free Quote'}
  </a>
</div>
