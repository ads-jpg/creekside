---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site, { on } from '../lib/config.js';
---

<Base title={`Page not found | ${site.client.name}`} description="That page does not exist." noindex={true}>
  {on(site.header) && <Header />}

  <main id="main" class="section">
    <div class="shell max-w-2xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-3xl font-bold sm:text-4xl">We could not find that page</h1>
      <p class="lede mt-4">
        The link may be out of date. Head back to the main page, or call us and we will point you in
        the right direction.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap">
        <a href="/" class="btn btn-primary btn-lg">Go to the main page</a>
        <a href={`tel:${site.contact.phone}`} class="btn btn-ghost btn-lg" data-track="call">
          Call {site.contact.phoneDisplay}
        </a>
      </div>
    </div>
  </main>

  {on(site.footer) && <Footer />}
</Base>
